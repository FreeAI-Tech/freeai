# Example only. Keep real secrets in a protected, ignored runtime file.
NODE_ENV=development
HOST=127.0.0.1
PORT=3080
PUBLIC_ORIGIN=http://localhost:3080
DB_DRIVER=sqlite
SQLITE_PATH=data/freeai.sqlite
MODERATION_MODE=pre
TRUST_PROXY=

# Production: NODE_ENV=production, HTTPS PUBLIC_ORIGIN, DB_DRIVER=mysql.
# Proxy must overwrite X-Real-IP; only then set TRUST_PROXY=loopback.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=REPLACE_WITH_DEDICATED_USER
# DB_PASSWORD=REPLACE_WITH_PRIVATE_VALUE
# DB_NAME=REPLACE_WITH_DEDICATED_DATABASE
# ADMIN_EMAIL=REPLACE_WITH_OWNER_EMAIL
# ADMIN_BOOTSTRAP_SECRET=REPLACE_WITH_ONE_TIME_PRIVATE_VALUE
# SIGNUP_INVITE_SECRET=REPLACE_WITH_PRIVATE_PILOT_INVITE
